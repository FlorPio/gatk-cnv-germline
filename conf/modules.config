/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When to run the module.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // nf-core GATK4 modules configuration
    //

    withName: 'GATK4_BEDTOINTERVALLIST' {
        ext.prefix = { "intervals" }
        publishDir = [
            path: { "${params.outdir}/intervals" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_PREPROCESSINTERVALS' {
        // Different from BedToIntervalList's prefix to avoid Nextflow
        // missing the output (the staged input would have the same name).
        ext.prefix = { "preprocessed_intervals" }
        // GATK PreprocessIntervals: applies --padding and --bin-length.
        // For panels/exomes use --bin-length 0 (keep target bins) and
        // tune padding to give more reads per bin in small exons.
        ext.args   = {
            def pad = params.bed_padding ?: 0
            "--padding ${pad} --bin-length 0 --interval-merging-rule OVERLAPPING_ONLY"
        }
        publishDir = [
            path: { "${params.outdir}/intervals" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_COLLECTREADCOUNTS' {
        ext.args = '--format TSV --interval-merging-rule OVERLAPPING_ONLY'
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_DETERMINEGERMLINECONTIGPLOIDY' {
        ext.args = '--interval-merging-rule OVERLAPPING_ONLY'
        publishDir = [
            path: { "${params.outdir}/ploidy" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_FILTERINTERVALS' {
        ext.prefix = { "filtered_intervals" }
        ext.args = { [
            "--minimum-gc-content ${params.minimum_gc_content}",
            "--maximum-gc-content ${params.maximum_gc_content}",
            "--minimum-mappability ${params.minimum_mappability}",
            "--maximum-segmental-duplication-content ${params.maximum_segmental_dup}",
            "--low-count-filter-count-threshold ${params.low_count_filter_count_threshold}",
            "--low-count-filter-percentage-of-samples ${params.low_count_filter_percentage_of_samples}",
            "--extreme-count-filter-minimum-percentile ${params.extreme_count_filter_minimum_percentile}",
            "--extreme-count-filter-maximum-percentile ${params.extreme_count_filter_maximum_percentile}",
            "--extreme-count-filter-percentage-of-samples ${params.extreme_count_filter_percentage_of_samples}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/intervals" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PON_MANIFEST' {
        publishDir = [
            path: { "${params.outdir}/pon" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'VALIDATE_PON_MANIFEST' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_ANNOTATEINTERVALS' {
        ext.args = '--interval-merging-rule OVERLAPPING_ONLY'
        ext.prefix = { "annotated_intervals" }
        publishDir = [
            path: { "${params.outdir}/intervals" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_GERMLINECNVCALLER' {
        ext.args = '--interval-merging-rule OVERLAPPING_ONLY'
        publishDir = [
            path: { "${params.outdir}/cnv_calls" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GATK4_POSTPROCESSGERMLINECNVCALLS' {
        ext.args = { [
            params.allosomal_contigs ? params.allosomal_contigs.split(',').collect { "--allosomal-contig $it" }.join(' ') : '--allosomal-contig chrX'
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/results/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Local modules configuration
    //

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: 'ANNOTATE_CNV_EXONS' {
        publishDir = [
            path: { "${params.outdir}/annotated/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
